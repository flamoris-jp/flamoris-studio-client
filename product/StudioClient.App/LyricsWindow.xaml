<Window x:Class="Flamoris.StudioClient.App.LyricsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="歌詞を読み込む／貼り付ける" Width="740" Height="560" MinWidth="520" MinHeight="380" WindowStartupLocation="CenterOwner" Background="#F3F5F7" FontFamily="Yu Gothic UI" FontSize="14">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="歌詞" FontSize="25" FontWeight="SemiBold"/>
    <DockPanel Grid.Row="1" Margin="0,8"><Button DockPanel.Dock="Right" Content="歌詞ファイルを開く…" Click="Open_Click"/>
      <TextBlock Text="1行ずつ貼り付け／TXT・JSON・SRTをドロップ。タグ・括弧だけの行は表示しません。" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="2" x:Name="DropBorder" BorderBrush="#7DA69D" BorderThickness="2" Background="White" CornerRadius="4" AllowDrop="True"
            PreviewDragOver="DragOver_Lyrics" PreviewDragLeave="DragLeave_Lyrics" PreviewDrop="Drop_Lyrics">
      <Grid><TextBox x:Name="LyricsInput" MaxLength="4000000" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="Input_Changed" Background="Transparent" BorderThickness="0"/>
        <TextBlock x:Name="EmptyHint" Text="ここに歌詞を貼り付けるか、歌詞ファイルをドロップしてね。" Foreground="#72828A" Margin="12" IsHitTestVisible="False" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <TextBlock Grid.Row="3" x:Name="ImportStatus" Text="確定するまで、編集中の歌詞・タイミングは変更しません。" Margin="0,10" TextWrapping="Wrap" Foreground="#52616F"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DistributionButton" Content="配信用歌詞…" Click="Distribution_Click"/>
      <Button Content="キャンセル" IsCancel="True"/>
      <Button x:Name="ApplyButton" Content="この歌詞で始める（1行ずつ）" Click="Apply_Click"/>
    </StackPanel>
  </Grid>
</Window>
