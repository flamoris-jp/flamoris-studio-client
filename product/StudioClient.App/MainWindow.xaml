<Window x:Class="Flamoris.StudioClient.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Flamoris.StudioClient.App"
 Title="FLAMORIS StudioClient — PONPON / AudioAnalyzer" Width="1320" Height="900" MinWidth="1000" MinHeight="720" Background="#F3F5F7" FontFamily="Yu Gothic UI" FontSize="13" Icon="Assets/StudioClient.ico">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="White">
      <MenuItem Header="ファイル">
        <MenuItem Header="新規" Click="New_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="プロジェクトを開く…" Click="Open_Click" InputGestureText="Ctrl+O"/>
        <MenuItem Header="保存" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem Header="名前を付けて保存…" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="歌詞を読み込む／貼り付ける…" Click="Import_Click"/>
        <MenuItem Header="SRTを書き出す…" Click="ExportSrt_Click"/>
        <MenuItem Header="歌詞タイミングJSONを書き出す…" Click="ExportTiming_Click"/>
        <MenuItem Header="PONPON JSONを書き出す…" Click="ExportPonpon_Click"/>
        <MenuItem Header="解析結果JSONを書き出す…" Click="ExportAnalysis_Click"/>
      </MenuItem>
      <MenuItem Header="編集">
        <MenuItem Header="元に戻す" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
        <MenuItem Header="やり直す" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
        <MenuItem Header="1つ前のPONに戻る" Click="UndoPon_Click" InputGestureText="Z"/>
        <MenuItem Header="タイミングを全クリア…" Click="ClearTimings_Click"/>
        <MenuItem Header="選択行の録り直し" Click="ClearLine_Click"/>
        <MenuItem Header="読み込み時の歌詞に戻す" Click="Restore_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#E4EBF0">
      <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="処理をキャンセル" IsEnabled="False" Click="Cancel_Click"/>
        <StackPanel><TextBlock x:Name="StatusText" Text="音源を開いて歌詞を貼ると、すぐに始められます。" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,5,0,0" Minimum="0" Maximum="100"/></StackPanel>
      </DockPanel>
    </Border>
    <TabControl Margin="10" x:Name="WorkspaceTabs">
      <TabItem Header="  PONPON / ぐにぐに  ">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/>
            <RowDefinition Height="8"/><RowDefinition Height="3*" MinHeight="90"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel><Button Content="音源を開く…" Click="Music_Click"/><Button Content="Vocal Stemを選ぶ…" Click="Vocal_Click"/>
            <ComboBox x:Name="PlaybackSource" Width="130" Margin="8,3" SelectionChanged="Source_Changed"><ComboBoxItem Content="Music" IsSelected="True"/><ComboBoxItem Content="Vocal Stem"/></ComboBox>
            <TextBlock x:Name="MusicLabel" Text="音源未選択" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="8,0"/>
            <Button Content="歌詞を読み込む／貼り付ける…" Click="Import_Click"/>
          </WrapPanel>
          <WrapPanel Grid.Row="1">
            <Button x:Name="UndoPonButton" Content="↶ 戻る (Z)" Click="UndoPon_Click" ToolTip="直前のPONを取り消し、その開始位置に戻って停止します。"/>
            <Button x:Name="ClearTimingsButton" Content="全クリア…" Click="ClearTimings_Click" ToolTip="歌詞・音源を残し、全行のタイミングを消して先頭へ戻ります。"/>
            <Button Content="▶ / Ⅱ 再生・停止" Click="Play_Click"/><Button Content="選択行から再生" Click="PlaySelected_Click"/><Button Content="先頭へ" Click="Start_Click"/>
            <TextBlock x:Name="ClockText" Text="00:00.000" FontSize="20" FontFamily="Consolas" VerticalAlignment="Center" Margin="15,0"/>
            <TextBlock Text="S：再生 / Space長押し：PON" Foreground="#52616F" VerticalAlignment="Center"/>
            <CheckBox x:Name="PreviewLyrics" Content="みるみる" Margin="14,0" VerticalAlignment="Center" Unchecked="Preview_Unchecked" ToolTip="再生位置の歌詞をプレビューします。"/>
          </WrapPanel>
          <Border Grid.Row="2" Background="#172F3B" CornerRadius="6" Padding="14" MinHeight="120">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="LineCounter" Foreground="#97BFC9" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" x:Name="CurrentLyric" Text="歌詞を読み込んでね" Foreground="White" FontSize="23" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="66" VerticalAlignment="Center"/>
              </Grid>
              <Button Grid.Column="1" x:Name="PonButton" Content="PON!" Width="210" Height="82" FontSize="29" FontWeight="Bold" Background="#BCEBDC" Foreground="#183F3B"
                      PreviewMouseLeftButtonDown="Pon_Down" PreviewMouseLeftButtonUp="Pon_Up" LostMouseCapture="Pon_LostCapture" ToolTip="Spaceを押している間も記録します。">
                <Button.Template><ControlTemplate TargetType="Button"><Grid>
                  <Border Background="#598F80" CornerRadius="10"/>
                  <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,0,5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid><ControlTemplate.Triggers>
                  <Trigger Property="Tag" Value="Held"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="4"/></Setter.Value></Setter><Setter Property="Background" Value="#F3CD68"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.92"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Button.Template>
              </Button>
              <Grid Grid.Column="2" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="NEXT" Foreground="#97BFC9"/>
                <TextBlock Grid.Row="1" x:Name="NextLyric" Foreground="#C1E2E8" FontSize="23" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="66" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,7,0,4">
            <WrapPanel>
              <TextBlock Text="ぐにぐに" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0" ToolTip="箱の中央で移動／左右端で時間調整。下の境界を上下にドラッグして領域の高さを変更。"/>
              <Button Content="−" Click="ZoomOut_Click" Padding="8,6"/><Button Content="＋" Click="ZoomIn_Click" Padding="8,6"/>
              <TextBlock Text="対象" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <ComboBox x:Name="EditScope" Width="92" SelectedIndex="0" Margin="0,3,7,3"><ComboBoxItem Content="選択行"/><ComboBoxItem Content="全行"/></ComboBox>
              <ComboBox x:Name="Adjustment" IsEditable="True" Width="100" Text="10ms" Margin="0,3,5,3" ToolTip="単位なしはms。例：10ms、0.01秒"/>
              <Button Content="← 前へ" Click="ShiftEarlier_Click"/><Button Content="後ろへ →" Click="ShiftLater_Click"/>
              <CheckBox x:Name="FollowPrevious" Content="前行の終了がついてく" VerticalAlignment="Center" Margin="10,0" ToolTip="開始を変更すると直前行の終了も追従します。初回は「今そろえる」。"/>
              <Button Content="今そろえる" Click="AlignPrevious_Click"/>

            </WrapPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="4" x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="Timeline_Scroll" SizeChanged="Timeline_SizeChanged">
            <local:TimingSurface x:Name="Timeline" Height="160"/>
          </ScrollViewer>
          <GridSplitter x:Name="RegionSplitter" Grid.Row="5" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#BBCAD2" Cursor="SizeNS" ToolTip="上下にドラッグして、ぐにぐにと歌詞一覧の高さを調整"/>
          <DataGrid Grid.Row="6" x:Name="LyricsGrid" Margin="0,9,0,5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" ToolTip="Ctrl・Shiftで複数行選択できます。" SelectionChanged="Line_Changed" MouseDoubleClick="Line_DoubleClick" CanUserAddRows="False" EnableRowVirtualization="True" RowHeight="30" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Item">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#DCEFE9"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            </Style.Triggers></Style></DataGrid.RowStyle>
            <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45"/><DataGridTextColumn Header="歌詞" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="開始" Binding="{Binding Start}" Width="115"/><DataGridTextColumn Header="終了" Binding="{Binding End}" Width="115"/></DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="7"><TextBlock Text="開始（秒）" VerticalAlignment="Center"/><TextBox x:Name="StartSeconds" Width="90" Margin="6,0"/>
            <TextBlock Text="終了（秒）" VerticalAlignment="Center"/><TextBox x:Name="EndSeconds" Width="90" Margin="6,0"/>
            <TextBox x:Name="SelectedText" Width="280" Margin="6,0"/><Button Content="選択行に適用" Click="ApplyLine_Click"/>
            <Button Content="保存" Click="Save_Click"/><Button Content="SRT出力" Click="ExportSrt_Click"/></WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="  AudioAnalyzer  ">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="曲を調べる" FontSize="28" FontWeight="SemiBold" Foreground="#173F46"/>
          <TextBlock Grid.Row="1" Text="音源だけで解析できます。歌詞・PONPON・セマンティック解析は不要です。" Margin="0,10" Foreground="#52616F"/>
          <StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button Content="解析する音源を選ぶ…" Click="AnalyzeFile_Click"/>
              <Button Content="PONPONのMusicを解析" Click="AnalyzeMusic_Click"/><Button Content="Vocal Stemを解析" Click="AnalyzeVocal_Click"/>
              <Button Content="結果を保存…" Click="ExportAnalysis_Click"/></StackPanel>
            <TextBlock x:Name="AnalysisLabel" Text="未解析" Margin="3,12" FontSize="17" TextWrapping="Wrap"/>
          </StackPanel>
          <local:TimingSurface Grid.Row="3" x:Name="AnalysisWave" Height="180"/>
          <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock DockPanel.Dock="Top" Text="推定コード（メジャー／マイナー三和音）— 自動推定のため、耳でも確認してください。" Margin="0,0,0,8"/>
            <DataGrid x:Name="ChordGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
              <DataGridTextColumn Header="開始（秒）" Binding="{Binding Start, StringFormat=F3}" Width="140"/><DataGridTextColumn Header="終了（秒）" Binding="{Binding End, StringFormat=F3}" Width="140"/><DataGridTextColumn Header="推定コード" Binding="{Binding Label}" Width="*"/>
            </DataGrid.Columns></DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
